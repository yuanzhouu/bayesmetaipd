\name{sim1_ipdad_rep1}
\alias{sim1_ipdad_rep1}
\docType{data}
\title{Simulation Study 1, replicate 1 (continuous IPD + Type 1/2/3 AD)}
\description{
Bundled first replicate generated by the Simulation Study 1 data-generating
process (\code{Data/Generate_Simulation_1.R}, \code{i_rep = 1}). Used by
default in \code{\link{fit_ipd_ad_sim1}} and \code{\link{reproduce_sim1_ipdad}}.
}
\format{
A list with components:
\describe{
  \item{X_cube}{Numeric array \code{L x n x p} (\code{L=40}, \code{n=200}, \code{p=4}).}
  \item{Y_mat}{Numeric matrix \code{L x n} of continuous responses.}
  \item{theta_l_mat}{Numeric matrix \code{L x p} of true study-specific coefficients.}
  \item{beta_mat}{Numeric matrix \code{L x p} of AD working-model estimates.}
  \item{V_beta_cube}{Numeric array \code{L x p x p} of AD working covariances.}
  \item{type_vec}{Length-\code{L} integer: \code{1} nested AD, \code{2} subgroup-mean AD,
    \code{3} partial-coefficient AD, \code{4} IPD.}
  \item{true_mu}{Numeric vector of length \code{p}.}
  \item{true_kappa}{Shared residual variance used to generate \code{Y}.}
  \item{random_seed}{\code{.Random.seed} after generating this replicate.}
}
}
\source{
Generated from the DGP in
\url{https://github.com/hang-kim-stat/Bayesian-Meta}.
}
\examples{
data(sim1_ipdad_rep1)
str(sim1_ipdad_rep1, max.level = 1)
}
